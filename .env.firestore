# 🔐 Configuração de Autenticação para Firestore

# Escolha UMA das opções abaixo:

# OPÇÃO 1: Usar gcloud (recomendado - mais fácil)
# Execute uma vez:
#   gcloud auth application-default login
# Depois rode:
#   ./run_seed_production.sh

# OPÇÃO 2: Usar arquivo de credenciais de serviço
# 1. Vá para: https://console.firebase.google.com/project/expogeo-fad33/settings/serviceaccounts/adminsdk
# 2. Clique "Gerar Nova Chave Privada"
# 3. Salve como: firebase-credentials.json (na raiz do projeto)
# 4. Descomente a linha abaixo:
export GOOGLE_APPLICATION_CREDENTIALS=firebase-credentials.json

# OPÇÃO 3: Especificar arquivo de credenciais com caminho customizado
# export GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/seu/firebase-credentials.json
